{
  "name": "api",
  "version": "1.0.0",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "stop": "docker-compose -f docker-compose.dev.yml down -v --rmi all --remove-orphans",
    "start": "node dist/server.js",
    "build": "rimraf dist && tsc",
    "dev": "docker-compose -f docker-compose.dev.yml up --build -d",
    "seed": "docker-compose -f docker-compose.dev.yml exec app npx sequelize-cli db:seed:all",
    "migrate": "docker-compose -f docker-compose.dev.yml exec app npx sequelize-cli db:migrate",
    "seed:undo": "docker-compose -f docker-compose.dev.yml exec app npx sequelize-cli db:seed:undo:all",
    "migrate:undo": "docker-compose -f docker-compose.dev.yml exec app npx sequelize-cli db:migrate:undo:all"
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.0",
    "express-rate-limit": "^8.1.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.7.0",
    "jsonwebtoken": "^9.0.2",
    "mariadb": "^3.4.2",
    "multer": "^2.0.2",
    "nodemailer": "^6.9.16",
    "sequelize": "^6.37.5",
    "sequelize-cli": "^6.6.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/helmet": "^0.0.48",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.0.9",
    "@types/nodemailer": "^7.0.5",
    "@types/sequelize": "^4.28.20",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "nodemon": "^3.1.10",
    "rimraf": "^6.1.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}